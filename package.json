    "typecheck": "tsc --noEmit",
    "brand": "node scripts/brand-images.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
